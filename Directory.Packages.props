<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="CSharpier.MSBuild" Version="1.3.0" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.317" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
    <GlobalPackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <GlobalPackageReference Include="NetEvolve.Analyzer" Version="0.20.50" />
    <GlobalPackageReference Include="NetEvolve.Defaults" Version="2.10.38" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.CodeFixes" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <GlobalPackageReference Include="Roslynator.Refactorings" Version="5.0.1" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Core" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="NetEvolve.Extensions.TUnit" Version="3.5.606" />
    <PackageVersion Include="TUnit" Version="1.76.0" />
    <PackageVersion Include="TUnit.Mocks" Version="1.76.0" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="ByteAether.Ulid" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>
</Project>
