<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <!--
        Only measure coverage for our own assemblies. Without this filter, third-party
        dependencies shipped with embedded/portable PDBs (e.g. Microsoft.Azure.Functions.Worker.Core)
        get instrumented too and dominate the overall coverage number with code we don't own
        and can't test.
      -->
      <Exclude>
        <ModulePath>.*\\Microsoft\..*\.dll$</ModulePath>
        <ModulePath>.*\\System\..*\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
